data/raw/
data/external/
data/interim/


# ============================================================
# Keep selected processed data
# ============================================================
# Ignore processed data by default
data/processed/*

# But keep important reduced/encoded datasets
!data/processed/daily_rentals_top20_reduced.csv
!data/processed/daily_rentals_top20_reduced_with_lag.csv
!data/processed/encoded_train.csv
!data/processed/encoded_validation.csv
!data/processed/encoded_test.csv
!data/processed/encoded_feature_names.csv

# Keep folder itself
!data/processed/.gitkeep


